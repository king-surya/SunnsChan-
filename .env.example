# Copy to .env (never commit real secrets)
SUNS_LLM_PROVIDER=fake
SUNS_LLM_MODEL=fake-echo
SUNS_LLM_BASE_URL=
SUNS_DB_PATH=data/sunschan.db
SUNS_RECALL_LIMIT=8
SUNS_ALLOW_SANDBOX_WRITE=1
SUNS_ALLOW_HOST_SHELL=0
SUNS_REQUIRE_APPROVAL=1
SUNS_AUDIT_LOG=logs/audit.log
SUNS_ENV_PROVIDER=fake
SUNS_LOG_LEVEL=INFO
SUNS_LOG_PATH=logs/sunschan.log
SUNS_API_ENABLED=0
SUNS_API_HOST=127.0.0.1
SUNS_API_PORT=8765
# VM sandbox (Phase 3). mock = in-memory backend for dev/tests.
SANDBOX_MODE=mock
SANDBOX_NETWORK=isolated
SANDBOX_TEMPLATE=debian-12-baseline
SANDBOX_VCPUS=2
SANDBOX_RAM_MB=4096
SANDBOX_DISK_GB=40
# Per-invocation human approval for REAL runs (python main.py --autonomy).
# SANDBOX_APPROVE_REAL=1
# Phase 5: all optional, all default-off/safe.
SENSORS_ENABLED=0
SENSORS_POLL=300
COMMS_ENABLED=0
VOICE_INPUT=none
VOICE_OUTPUT=none
AVATAR_PROVIDER=none
# Proxmox credentials: infrastructure layer only, never logged or prompted.
# PROXMOX_HOST=proxmox.lan:8006
# PROXMOX_USER=suns@pve
# PROXMOX_TOKEN_NAME=sandbox
# PROXMOX_TOKEN_VALUE=
# PROXMOX_NODE=pve
# PROXMOX_TEMPLATE_ID=9000
